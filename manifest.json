{
  "name": "My Darts Score Tracker",
  "short_name": "Darts Tracker",
  "description": "A progressive web app for tracking darts scores offline with player profiles and statistics",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#b45309",
  "dir": "ltr",
  "lang": "en-US",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./dartboard.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./dartboard.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "categories": ["games", "productivity"],
  "shortcuts": [
    {
      "name": "Start Match",
      "short_name": "Match",
      "description": "Start a new darts match",
      "url": "./index.html?mode=play",
      "icons": [
        {
          "src": "./dartboard.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "View Statistics",
      "short_name": "Stats",
      "description": "View player statistics",
      "url": "./index.html?mode=stats",
      "icons": [
        {
          "src": "./dartboard.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
